{
  "start_urls": ["https://example.com"],
  "crawler": {"max_pages": 100, "max_depth": 2, "rate_limit": 5, "respect_robots": true},
  "filters": {"exclude_patterns": ["\\.pdf$", "/login"]},
  "storage": {"type": "json", "path": "results.json"},
  "logging": {"file": "crawler.log", "level": "INFO"},
  "report": {"json": "stats.json", "html": "report.html"}
}